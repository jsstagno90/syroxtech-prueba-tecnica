{
  "name": "admin-panel",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @admin/shared build && pnpm --parallel --filter @admin/shared --filter api --filter web dev",
    "build": "pnpm --filter api --filter web build",
    "test": "pnpm --filter api test",
    "lint": "pnpm --filter api --filter web lint",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:seed": "pnpm --filter api prisma:seed",
    "db:reset-demo": "pnpm --filter api prisma:seed:reset"
  }
}
