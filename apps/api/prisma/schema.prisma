generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  /// Hasta cuándo vio las notificaciones (las posteriores cuentan como nuevas).
  notificationsSeenAt DateTime? @map("notifications_seen_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Categorías jerárquicas: una categoría sin padre es "principal".
model Category {
  id        Int        @id @default(autoincrement())
  name      String
  position  Int        @default(0)
  parentId  Int?       @map("parent_id")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("brands")
}

/// Sin stock ni pasarela de pagos (fuera del alcance pedido).
model Product {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  price       Decimal    @db.Decimal(12, 2)
  sku         String?    @unique
  /// Imagen principal (la primera de `images`). Se mantiene aparte para listados, import y export.
  imageUrl    String?    @map("image_url")
  images      String[]   @default([])
  gender      ProductGender?
  /// Opciones que generan las variantes, ej. [{ "name": "Talla", "values": ["38", "39"] }].
  options     Json       @default("[]")
  variants    ProductVariant[]
  isActive    Boolean    @default(true) @map("is_active")
  categoryId  Int        @map("category_id")
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId     Int?       @map("brand_id")
  brand       Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  saleItems   SaleItem[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

enum ProductGender {
  MALE
  FEMALE
  UNISEX
  KIDS
}

/// Una combinación de opciones (ej. Talla 40 / Color Negro). Sin stock, como pide la consigna.
model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Valor elegido de cada opción, ej. { "Talla": "40", "Color": "Negro" }.
  options   Json
  sku       String?  @unique
  /// Si es null usa el precio del producto.
  price     Decimal? @db.Decimal(12, 2)
  isActive  Boolean  @default(true) @map("is_active")
  position  Int      @default(0)

  @@index([productId])
  @@map("product_variants")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

/// Cupón de descuento que se puede aplicar al generar una venta.
model Discount {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  description String?
  type        DiscountType
  value       Decimal      @db.Decimal(12, 2)
  minPurchase Decimal?     @map("min_purchase") @db.Decimal(12, 2)
  usageLimit  Int?         @map("usage_limit")
  startsAt    DateTime?    @map("starts_at")
  endsAt      DateTime?    @map("ends_at")
  isActive    Boolean      @default(true) @map("is_active")
  sales       Sale[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("discounts")
}

/// Nivel de membresía: el cliente entra según lo que gastó y el nivel multiplica sus puntos.
model MembershipTier {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  minSpent         Decimal  @map("min_spent") @db.Decimal(12, 2)
  pointsMultiplier Decimal  @default(1) @map("points_multiplier") @db.Decimal(4, 2)
  benefits         String?
  color            String   @default("slate")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("membership_tiers")
}

/// Configuración de la tienda (una sola fila).
model StoreSettings {
  id             Int      @id @default(1)
  storeName      String   @map("store_name")
  contactEmail   String?  @map("contact_email")
  contactPhone   String?  @map("contact_phone")
  address        String?
  /// Programa de puntos: 1 punto cada `amountPerPoint` pesos gastados.
  loyaltyEnabled Boolean  @default(true) @map("loyalty_enabled")
  amountPerPoint Decimal  @default(1000) @map("amount_per_point") @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

/// Imágenes subidas desde el panel. Se guardan en la base para no depender de un storage externo.
model UploadedImage {
  id        String   @id @default(uuid()) @db.Uuid
  mimeType  String   @map("mime_type")
  size      Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("uploaded_images")
}

enum SaleStatus {
  PENDING
  PREPARING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  CASH
  TRANSFER
}

/// Los datos del cliente se guardan en la venta (snapshot): si después cambian, el comprobante no se altera.
model Sale {
  id              Int                 @id @default(autoincrement())
  orderNumber     String              @unique @map("order_number")
  customerName    String              @map("customer_name")
  customerEmail   String              @map("customer_email")
  customerPhone   String?             @map("customer_phone")
  shippingAddress String?             @map("shipping_address")
  trackingNumber  String?             @map("tracking_number")
  paymentMethod   PaymentMethod       @map("payment_method")
  paymentStatus   PaymentStatus       @default(PENDING) @map("payment_status")
  status          SaleStatus          @default(PENDING)
  notes           String?
  subtotal        Decimal             @default(0) @db.Decimal(12, 2)
  /// Cupón aplicado (se copia el código por si después se borra el cupón).
  discountId      Int?                @map("discount_id")
  discount        Discount?           @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountCode    String?             @map("discount_code")
  discountAmount  Decimal             @default(0) @map("discount_amount") @db.Decimal(12, 2)
  total           Decimal             @db.Decimal(12, 2)
  items           SaleItem[]
  history         SaleStatusHistory[]
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([customerEmail])
  @@map("sales")
}

/// Nombre y precio se copian al momento de la venta: borrar o editar el producto no cambia ventas pasadas.
model SaleItem {
  id          Int      @id @default(autoincrement())
  saleId      Int      @map("sale_id")
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   Int?     @map("product_id")
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String   @map("product_name")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SaleStatusHistory {
  id        Int        @id @default(autoincrement())
  saleId    Int        @map("sale_id")
  sale      Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  status    SaleStatus
  note      String?
  createdBy String     @map("created_by")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([saleId])
  @@map("sale_status_history")
}
