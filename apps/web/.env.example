# URL de la API NestJS (la usa el servidor de Next, nunca el navegador)
API_URL=http://localhost:3001

# Personalización de la tienda (opcional)
NEXT_PUBLIC_STORE_NAME="Tennis Star"
NEXT_PUBLIC_LOCALE=es-AR
NEXT_PUBLIC_CURRENCY=ARS

# Mostrar las credenciales demo en el login (poner false en un entorno real)
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true
