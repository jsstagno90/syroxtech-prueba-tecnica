generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Categorías jerárquicas: una categoría sin padre es "principal".
model Category {
  id        Int        @id @default(autoincrement())
  name      String
  position  Int        @default(0)
  parentId  Int?       @map("parent_id")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("brands")
}

/// Sin stock ni pasarela de pagos (fuera del alcance pedido).
model Product {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  price       Decimal    @db.Decimal(12, 2)
  sku         String?    @unique
  imageUrl    String?    @map("image_url")
  isActive    Boolean    @default(true) @map("is_active")
  categoryId  Int        @map("category_id")
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId     Int?       @map("brand_id")
  brand       Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  saleItems   SaleItem[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

enum SaleStatus {
  PENDING
  PREPARING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  CASH
  TRANSFER
}

/// Los datos del cliente se guardan en la venta (snapshot): si después cambian, el comprobante no se altera.
model Sale {
  id              Int                 @id @default(autoincrement())
  orderNumber     String              @unique @map("order_number")
  customerName    String              @map("customer_name")
  customerEmail   String              @map("customer_email")
  customerPhone   String?             @map("customer_phone")
  shippingAddress String?             @map("shipping_address")
  paymentMethod   PaymentMethod       @map("payment_method")
  paymentStatus   PaymentStatus       @default(PENDING) @map("payment_status")
  status          SaleStatus          @default(PENDING)
  notes           String?
  total           Decimal             @db.Decimal(12, 2)
  items           SaleItem[]
  history         SaleStatusHistory[]
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("sales")
}

/// Nombre y precio se copian al momento de la venta: borrar o editar el producto no cambia ventas pasadas.
model SaleItem {
  id          Int      @id @default(autoincrement())
  saleId      Int      @map("sale_id")
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   Int?     @map("product_id")
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String   @map("product_name")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SaleStatusHistory {
  id        Int        @id @default(autoincrement())
  saleId    Int        @map("sale_id")
  sale      Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  status    SaleStatus
  note      String?
  createdBy String     @map("created_by")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([saleId])
  @@map("sale_status_history")
}
