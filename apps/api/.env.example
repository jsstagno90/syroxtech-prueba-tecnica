# Conexión a PostgreSQL (docker compose up -d db levanta una con estos datos)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/admin_panel?schema=public"

# Clave para firmar los JWT: mínimo 32 caracteres (openssl rand -base64 32)
JWT_SECRET="cambiar-por-una-clave-larga-y-aleatoria-de-32+"

PORT=3001

# Orígenes que pueden llamar a la API (separados por coma)
CORS_ORIGINS="http://localhost:3000"
